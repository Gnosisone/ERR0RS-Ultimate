# ──────────────────────────────────────────────────────────────────────────────
# ERR0RS — Environment Configuration (TEMPLATE)
# ──────────────────────────────────────────────────────────────────────────────
# Copy this to .env and fill in your values. The real .env is gitignored.
# ERR0RS runs 100% offline at runtime even if all API keys here are blank —
# these only matter for BUILD-TIME teach data generation (Phase 3).
# ──────────────────────────────────────────────────────────────────────────────

# ── LLM Backends (build-time only — runtime is fully local) ───────────────────
# See docs/BACKEND_STRATEGY.md for why this order.

# PRIMARY: Claude (Anthropic). Recommended. Best quality, best fit for
# ERR0RS's pedagogy mission. ~$0.25-3 for a one-time full teach sweep.
# Get a key: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# SECONDARY: DeepSeek. Cheaper (~5-10x), open weights, future local path.
# Get a key: https://platform.deepseek.com/
DEEPSEEK_API_KEY=

# Not currently used by ERR0RS directly, but reserved for OpenAI-compatible
# endpoints if you want to wire GPT or another OpenAI-compat provider.
OPENAI_API_KEY=

# ── Backend selection ─────────────────────────────────────────────────────────
# 'auto' walks the fallback chain. Or force one: claude, deepseek, ollama.
LLM_BACKEND=auto
LLM_FALLBACK_CHAIN=claude,deepseek,ollama

# ── Per-backend model overrides (optional) ────────────────────────────────────
# Leave blank to use the defaults baked into the code.
ANTHROPIC_MODEL=          # default: claude-sonnet-4-6-20260101
DEEPSEEK_MODEL=           # default: deepseek-chat
OLLAMA_MODEL=gemma3:1b
OLLAMA_HOST=http://localhost:11434

# ── Database (optional — for engagement memory) ───────────────────────────────
DB_URL=postgresql://errorz:err0rs_secure@localhost/errorz
REDIS_URL=redis://localhost:6379

# ── Web UI ────────────────────────────────────────────────────────────────────
UI_HOST=127.0.0.1
UI_PORT=8765

# ── Security ──────────────────────────────────────────────────────────────────
# install.sh auto-generates a random SECRET_KEY when it writes your .env.
# If you copy this template manually, generate one with:
#   openssl rand -hex 32
SECRET_KEY=

# ── Hardware flags (auto-detected at runtime — these are hints) ───────────────
HAILO_ENABLED=false       # true if hailortcli fw-control identify works
PI5_MODE=false            # true on Raspberry Pi 5 cyberdeck
DISTRO=kali               # kali, parrot, debian, ubuntu

# ──────────────────────────────────────────────────────────────────────────────
# Notes for first-time setup:
# 1. Copy this file to .env:  cp .env.example .env
# 2. Fill in at least ANTHROPIC_API_KEY OR DEEPSEEK_API_KEY for Phase 3
#    (or leave both blank and run Ollama-only — slower but free + local)
# 3. install.sh creates a fresh .env automatically. This template is for
#    reference and manual edits.
# ──────────────────────────────────────────────────────────────────────────────

# ──────────────────────────────────────────────────────────────────────────────
# Safety gate — pre-execution authorization checks
# ──────────────────────────────────────────────────────────────────────────────
# By default ERR0RS REFUSES to run tools against any target not covered by
# an active authorization record (~/.err0rs/authorization.json). This is the
# CFAA-compliant default — unauthorized testing is a federal crime.
#
# LAB MODE: set ERR0RS_LAB_MODE=1 to auto-permit localhost (127.0.0.1, ::1),
# RFC1918 ranges (10/8, 172.16/12, 192.168/16), and any hostnames listed in
# ERR0RS_LAB_TARGETS. A warning banner prints once per session. NEVER enable
# lab mode against systems you don't own or have written permission to test.
#
# ERR0RS_LAB_MODE=0
# ERR0RS_LAB_TARGETS=my-lab-vm.local,192.0.2.10
#
# Want to authorize a real engagement? See:
#   python3 -m src.security.cli_authorize --help
# ──────────────────────────────────────────────────────────────────────────────
