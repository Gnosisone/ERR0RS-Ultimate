{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Gnosisone/ERR0RS-Ultimate/src/tools/tool_registry.schema.json",
  "title": "ERR0RS Unified Tool Registry",
  "description": "Single source of truth for every tool ERR0RS knows about.",
  "type": "object",
  "properties": {
    "version": { "type": "string" },
    "generated_at": { "type": "string", "format": "date-time" },
    "tools": {
      "type": "object",
      "patternProperties": {
        "^[a-z][a-z0-9_-]*$": { "$ref": "#/$defs/tool" }
      },
      "additionalProperties": false
    },
    "concepts": {
      "type": "object",
      "patternProperties": {
        "^[a-z][a-z0-9_-]*$": { "$ref": "#/$defs/concept" }
      },
      "additionalProperties": false
    }
  },
  "required": ["version", "tools"],
  "$defs": {
    "tool": {
      "type": "object",
      "required": ["display_name", "binary", "category", "tier", "description", "teach_intro"],
      "properties": {
        "display_name": { "type": "string" },
        "aliases": { "type": "array", "items": { "type": "string" } },
        "binary": { "type": "string" },
        "category": {
          "type": "string",
          "enum": ["recon", "web", "exploitation", "post-exploit", "persistence", "c2", "wireless", "credentials", "forensics", "reverse", "evasion", "social-engineering", "mobile", "cloud", "container", "ad", "network", "hardware", "ids", "utility"]
        },
        "phases": { "type": "array", "items": { "type": "string" } },
        "tier": { "type": "integer", "enum": [1, 2, 3] },
        "risk": {
          "type": "string",
          "enum": ["stealthy", "moderate", "noisy", "loud", "safe", "quiet", "very_noisy", "requires_root", "slow", "depends_on_script", "destructive"]
        },
        "authorization_required": { "type": "boolean" },
        "description": { "type": "string" },
        "teach_intro": { "type": "string" },
        "teach_alt": { "type": "string" },
        "default_flags": { "type": "array", "items": { "type": "string" } },
        "default_command": { "type": "string" },
        "flags": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/flag" }
        },
        "output_read": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["pattern", "meaning"],
            "properties": {
              "pattern": { "type": "string" },
              "meaning": { "type": "string" }
            }
          }
        },
        "opsec_notes": { "type": "array", "items": { "type": "string" } },
        "sample_outputs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["scenario", "output", "explanation"],
            "properties": {
              "scenario": { "type": "string" },
              "command": { "type": "string" },
              "output": { "type": "string" },
              "explanation": { "type": "string" }
            }
          }
        },
        "legal_notes": { "type": "array", "items": { "type": "string" } },
        "false_positives": { "type": "array", "items": { "type": "string" } },
        "mitre_attack": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "name"],
            "properties": {
              "id": { "type": "string", "pattern": "^T[0-9]{4}(\\.[0-9]{3})?$" },
              "name": { "type": "string" }
            }
          }
        },
        "learning_path": {
          "type": "object",
          "properties": {
            "prerequisites": { "type": "array", "items": { "type": "string" } },
            "leads_to": { "type": "array", "items": { "type": "string" } }
          }
        },
        "common_pitfalls": { "type": "array", "items": { "type": "string" } },
        "related_tools": { "type": "array", "items": { "type": "string" } },
        "next_steps": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["if", "suggest"],
            "properties": {
              "if": { "type": "string" },
              "suggest": { "type": "string" }
            }
          }
        },
        "references": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["type", "url"],
            "properties": {
              "type": { "type": "string", "enum": ["official", "cheatsheet", "tutorial", "video", "writeup", "cve", "blog"] },
              "url": { "type": "string", "format": "uri" }
            }
          }
        }
      },
      "additionalProperties": false
    },
    "flag": {
      "type": "object",
      "required": ["label", "teach"],
      "properties": {
        "label": { "type": "string" },
        "desc": { "type": "string" },
        "example": { "type": "string" },
        "teach": { "type": "string" },
        "mechanism": { "type": "string" },
        "detection": { "type": "string" },
        "evasion": { "type": "string" },
        "risk": {
          "type": "string",
          "enum": ["stealthy", "moderate", "noisy", "loud", "safe", "quiet", "very_noisy", "requires_root", "slow", "depends_on_script", "destructive"]
        }
      },
      "additionalProperties": false
    },
    "concept": {
      "type": "object",
      "required": ["display_name", "summary"],
      "properties": {
        "display_name": { "type": "string" },
        "aliases": { "type": "array", "items": { "type": "string" } },
        "category": { "type": "string", "enum": ["framework", "doctrine", "model", "standard", "phase"] },
        "summary": { "type": "string" },
        "teach": { "type": "string" },
        "components": { "type": "array", "items": { "type": "string" } },
        "related": { "type": "array", "items": { "type": "string" } },
        "references": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["type", "url"],
            "properties": {
              "type": { "type": "string" },
              "url": { "type": "string", "format": "uri" }
            }
          }
        }
      },
      "additionalProperties": false
    }
  }
}
